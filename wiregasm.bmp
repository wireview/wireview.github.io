		<avp name="Filter-Rule-Precedence" code="510" mandatory="may">
			<type type-name="Unsigned32"/>
		</avp>
		<avp name="Classifier" code="511" mandatory="must" may-encrypt="no" protected="mustnot" vendor-bit="mustnot">
			<grouped>
				<gavp name="Classifier-ID"/>
				<gavp name="Protocol"/>
				<gavp name="Direction"/>
