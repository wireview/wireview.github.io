ATTRIBUTE	DHCP-HTTP-Proxy				135	octets

ATTRIBUTE	DHCP-Cisco-TFTP-Server-IP-Addresses	150	ipaddr array

ATTRIBUTE	DHCP-End-Of-Options			255	byte

